# Self-hosted Pangolin Community Edition Integration API origin. Required.
# Example: http://127.0.0.1:3003 or https://api.example.com
# A trailing /v1 is stripped. Cloud hosts (pangolin.net) are refused.
PANGOLIN_URL=

# Integration API key. Sent as Authorization: Bearer. Never printed. At least 8 characters.
PANGOLIN_API_KEY=

# Contact embedded in the User-Agent. Must not be the API key.
PANGOLIN_CONTACT=you@example.com

# Local sliding window. Cache hits do not spend it.
PANGOLIN_PER_MINUTE=30

# Cache TTL in seconds. 0 disables caching.
PANGOLIN_CACHE_TTL_SEC=60

# Upstream timeout in milliseconds.
PANGOLIN_TIMEOUT_MS=20000

# Must be the literal true before a confirmed write is sent.
PANGOLIN_ALLOW_WRITES=false

# Comma list of toolsets, or all. Default sites,resources,targets,roles,users,orgs.
PANGOLIN_TOOLSETS=

# stdio (default) or http. --http on the command line forces http.
MCP_TRANSPORT=stdio
PORT=3000
